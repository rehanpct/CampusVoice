# MySQL (create database first, e.g. campus_compliments)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/campus_compliments"

# Server
PORT=5000

# Auth — use a long random secret in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS: comma-separated origins, or omit to reflect request origin (dev only)
# CORS_ORIGIN="http://localhost:5173"

# Optional: comma-separated extra bad words (merged with built-in list)
# BAD_WORDS_LIST="word1,word2"
